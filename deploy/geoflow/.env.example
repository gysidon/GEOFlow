# GEOFlow 独立部署配置模板
#
# 用法：cp .env.example .env，然后逐项替换 CHANGE_ME / your-domain 等占位符。
# 文件里所有 CHANGE_ME_* 都必须改；带 your-domain 的按实际情况改。
#
# 部署步骤见同目录 README.md。

# ===========================================================================
# 一、镜像来源（阿里云容器镜像服务）
# ===========================================================================

# 拉取镜像需要登录 ACR：
#   docker login --username=<ACR用户名> registry.cn-chengdu.aliyuncs.com
# ACR 用户名在控制台「实例列表 → 访问凭证」页面查看。
# 若是私有仓库且服务器未登录，每台部署机器都要执行一次 docker login。

# 镜像地址规则：<ACR地址>/<命名空间>/<仓库名>:<版本>
# 命名空间是阿里云账号名，仓库名在 ACR 控制台「镜像仓库」里创建，两个仓库各一份：
#   geoflow-app  → 对应仓库根目录的 Dockerfile
#   geoflow-web  → 对应仓库根目录的 Dockerfile.web
# 版本号与源码 tag 对应：源码打 release-v3.1.0 时，ACR 自动构建出 3.1.0 版本镜像。
# 生产环境务必锁定具体版本号（不要用 latest），便于回滚与问题追溯。
GEOFLOW_APP_IMAGE=registry.cn-chengdu.aliyuncs.com/kintreda/geoflow-app:3.1.0
GEOFLOW_WEB_IMAGE=registry.cn-chengdu.aliyuncs.com/kintreda/geoflow-web:3.1.0

# ===========================================================================
# 二、PostgreSQL（外部实例，不启动数据库容器）
# ===========================================================================

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_PG_HOST
DB_PORT=5432
DB_DATABASE=CHANGE_ME_PG_DATABASE
DB_USERNAME=CHANGE_ME_PG_USERNAME
DB_PASSWORD=CHANGE_ME_PG_PASSWORD

# SSL 模式：自建内网实例通常用 prefer；云托管实例（RDS/PolarDB 等）一般需要 require。
# 取值：disable / allow / prefer / require / verify-ca / verify-full
# 注意：若实例未启用 TLS（SHOW ssl; 返回 off），require 会导致连接失败。
DB_SSLMODE=prefer

# ===========================================================================
# 三、Redis（外部实例，不启动 Redis 容器）
# ===========================================================================

# 生产镜像内置 PECL redis 扩展，保持 phpredis 即可，无需 predis。
REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PORT=6379
# 无密码时留空；不要写 null 字面量。
REDIS_PASSWORD=
# 逻辑库编号。若 Redis 为集群模式（只支持 db 0），下面两项都必须写 0。
# 若与他人共用同一 Redis，请挑空闲库号，避免键冲突。
REDIS_DB=0
REDIS_CACHE_DB=1

# ===========================================================================
# 四、队列与缓存
# ===========================================================================

# 队列驱动必须与 Redis 连通性一致；应用侧所有异步任务都走这里。
QUEUE_CONNECTION=redis
# 必须大于应用内最长队列任务 timeout（系统更新任务 900 秒），否则任务会被重复执行。
REDIS_QUEUE_RETRY_AFTER=960
DB_QUEUE_RETRY_AFTER=960

# 缓存存储。database 落到 PG 表里，redis 走 Redis，两者都可用。
CACHE_STORE=redis
CACHE_LIMITER_STORE=database

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false

# ===========================================================================
# 五、站点与域名
# ===========================================================================

APP_NAME=GEOFlow
APP_ENV=production
APP_DEBUG=false
# 站点对外地址。https 部署时下面 SESSION_SECURE_COOKIE 必须为 true。
APP_URL=https://your-domain.com
SITE_URL=https://your-domain.com
ASSET_URL=

# 应用加密密钥。留空则由容器启动时生成，但容器需能写 .env 文件；
# 若目标服务器不允许写 .env，请在此预填（用下方命令生成）。
#   docker run --rm --entrypoint sh <GEOFLOW_APP_IMAGE> -c 'head -c 32 /dev/urandom | base64'
#   然后写成 APP_KEY=base64:<上面输出>
APP_KEY=

# 首次安装时必须为 true（安装完成后改回 false）。
# 这是安全门禁：允许在空库上执行 schema 变更的迁移。
# 已有数据的实例升级时不要开这个开关，要按 README 的升级流程走排空确认。
GEOFLOW_SECURITY_FRESH_INSTALL_CONFIRMED=true
GEOFLOW_SECURITY_UPGRADE_DRAIN_CONFIRMED=false

# 后台入口路径，默认 geo_admin。
ADMIN_BASE_PATH=geo_admin

# 时区与语言
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
GEOFLOW_PUBLIC_LOCALE=zh_CN

# ===========================================================================
# 六、Nginx 与 WebSocket
# ===========================================================================

# 对外端口。宿主机 80 已被占用时用 18080，前面再挂反向代理。
WEB_PORT=18080

# Nginx 匹配的域名。必须与实际访问域名一致，否则请求会命中 default_server
# 并返回 444（表现为「Empty reply from server」而非 404）。
GEOFLOW_NGINX_PRIMARY_HOST=your-domain.com
GEOFLOW_NGINX_PRIMARY_ALIASES=www.your-domain.com
GEOFLOW_NGINX_HOSTED_ROOT_DOMAIN=invalid
GEOFLOW_NGINX_PUBLIC_SCHEME=https
GEOFLOW_NGINX_PUBLIC_PORT=443

# 站点白名单。必须包含上面的 GEOFLOW_NGINX_PRIMARY_HOST，
# 否则 Laravel 的 ResolveCurrentSite 中间件判定失败，全站返回 404。
# 两个变量的域名必须一致，改一处就要改另一处。
GEOFLOW_PRIMARY_HOSTS=your-domain.com,www.your-domain.com

# 多站点功能默认关闭；启用前先读 docs/blue-green-deployment-usage.md。
GEOFLOW_HOSTED_SITES_ENABLED=false
GEOFLOW_HOSTED_SITE_ROOT_DOMAINS=sites.your-domain.com

# Reverb（WebSocket）。宿主机对外端口由反向代理决定，容器内固定 18080。
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=geoflow-reverb-app
REVERB_APP_KEY=CHANGE_ME_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_APP_SECRET
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=18080
REVERB_BROADCAST_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=18080
REVERB_SERVER_PATH=/reverb
REVERB_ALLOWED_ORIGINS=your-domain.com,www.your-domain.com

# ===========================================================================
# 七、Cookie 与代理
# ===========================================================================

# HTTPS 部署保持 true；直接用 http://IP:端口 访问必须设为 false，否则浏览器不回传登录 Cookie。
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# 反向代理、CDN 或负载均衡时填实际代理 IP/CIDG；直连部署留空。
# 避免填 *，否则直连客户端可伪造转发地址绕过按 IP 的登录限流。
TRUSTED_PROXIES=REMOTE_ADDR

# ===========================================================================
# 八、Compose 与网络
# ===========================================================================

COMPOSE_PROJECT_NAME=geoflow
DOCKER_NETWORK_NAME=geoflow-net
# 避开 VPC 172.16.0.0/12，避免容器路由与内网地址冲突。
DOCKER_NETWORK_SUBNET=10.88.0.0/16
DOCKER_NETWORK_GATEWAY=10.88.0.1

# ===========================================================================
# 九、资源限制
# ===========================================================================

APP_CONTAINER_MEMORY_LIMIT=768m
QUEUE_CONTAINER_MEMORY_LIMIT=384m
KNOWLEDGE_QUEUE_CONTAINER_MEMORY_LIMIT=256m
AI_QUALITY_QUEUE_CONTAINER_MEMORY_LIMIT=384m
AI_QUALITY_BACKFILL_QUEUE_CONTAINER_MEMORY_LIMIT=256m
AI_OPTIMIZATION_QUEUE_CONTAINER_MEMORY_LIMIT=384m
# AI 质检并发副本数。内存紧张（4G 以下）时降为 1。
AI_QUALITY_QUEUE_REPLICAS=1

# ===========================================================================
# 十、初始化开关（由 init 一次性容器消费）
# ===========================================================================

AUTO_WAIT_FOR_DB=true
AUTO_MIGRATE=true
AUTO_INSTALL_ONCE=true
AUTO_OPTIMIZE=true
AUTO_FIX_STORAGE_PERMISSIONS=true

# ===========================================================================
# 十一、邮件与日志
# ===========================================================================

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ===========================================================================
# 十二、后台初始账号
# ===========================================================================

GEOFLOW_ADMIN_USERNAME=admin
GEOFLOW_ADMIN_EMAIL=admin@your-domain.com
# 留空则安装时随机生成一次性密码（会打印在 init 容器日志里）。
GEOFLOW_ADMIN_PASSWORD=
